     args = parser.parse_args()
 
+    # === Resume mode ===
+    # `python translate.py --resume <translation_id>` continues an interrupted
+    # CLI translation. Job data lives in data/jobs.db: the checkpoint rows
+    # record exactly which chunks completed, so the same pipeline that wrote
+    # them (GenericTranslator for TXT/SRT, the partial-state machinery for
+    # EPUB/DOCX) reloads them by translation_id and retranslates only what is
+    # still pending - completed work is never re-run. Parameters of the
+    # original run (input/output paths, languages, model, provider, prompt
+    # options) are restored from the persisted job config; -o/--output,
+    # -m/--model and --provider explicitly given on the command line override
+    # the stored values.
+    resume_checkpoint = None
+    resume_from_index = 0
+    resume_job_config = {}
+    if args.resume:
+        if args.input:
+            parser.error("-i/--input cannot be combined with --resume: the input "
+                         "file is restored from the job checkpoint")
+        if args.refine_only:
+            parser.error("--refine-only cannot be combined with --resume: the "
+                         "refinement pass has no checkpoint of its own")
+        if args.text_cleanup or args.refine or args.glossary \
+                or args.auto_glossary or args.auto_style:
+            parser.error("--text-cleanup/--refine/--glossary/--auto-glossary/"
+                         "--auto-style cannot be combined with --resume: the "
+                         "job's original prompt options are restored from the "
+                         "checkpoint (start a new translation to change them)")
+
+        resume_checkpoint = CheckpointManager().load_checkpoint(args.resume)
+        if resume_checkpoint is None:
+            parser.error(f"No checkpoint found for translation id '{args.resume}'. "
+                         "Run a translation first (job data lives in data/jobs.db) "
+                         "or use -i to start a new translation.")
+        job = resume_checkpoint['job']
+        if job.get('status') == 'completed':
+            parser.error(f"Translation job '{args.resume}' is already completed. "
+                         "Delete its checkpoint to translate it again from scratch.")
+        resume_job_config = job.get('config') or {}
+
+        # Restore the job parameters from the checkpoint. The preserved input
+        # is preferred because the original upload path may no longer exist.
+        input_path = (resume_job_config.get('preserved_input_path')
+                      or resume_job_config.get('input_file_path'))
+        if not input_path or not os.path.exists(input_path):
+            parser.error(f"Checkpoint input file is missing: {input_path or '(none)'}. "
+                         "The preserved upload may have been cleaned up; start a "
+                         "new translation with -i instead.")
+        args.input = input_path
+        if args.output is None:
+            args.output = resume_job_config.get('output_file_path')
+        if not args.output:
+            parser.error(f"Checkpoint for '{args.resume}' has no output_file_path.")
+        args.source_lang = resume_job_config.get('source_language') or args.source_lang
+        args.target_lang = resume_job_config.get('target_language') or args.target_lang
+        if args.model == DEFAULT_MODEL:
+            args.model = resume_job_config.get('model_name') or args.model
+        if args.provider == LLM_PROVIDER:
+            args.provider = resume_job_config.get('llm_provider') or args.provider
+        resume_from_index = resume_checkpoint.get('resume_from_index', 0)
+    elif not args.input:
+        parser.error("-i/--input is required (or use --resume <translation_id> "
+                     "to continue an interrupted job)")
+
+    # Unique id for this run, or the resumed job's id. Printed in the start
+    # log below so an interrupted run can later be continued with
+    # `python translate.py --resume <this id>`.
+    translation_id = args.resume or f"cli_{uuid.uuid4().hex[:8]}"
